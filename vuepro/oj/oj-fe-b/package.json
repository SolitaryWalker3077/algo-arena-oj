{
  "name": "oj-fe-b",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src test --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,scss,json,md}\" \"test/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,css,scss,json,md}\" \"test/**/*.{js,ts}\"",
    "preview": "vite preview",
    "test": "vitest run --coverage && node --test \"test/*.test.js\"",
    "test:unit": "vitest run --coverage",
    "test:legacy": "node --test \"test/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@element-plus/icons-vue": "^2.3.2",
    "@lezer/highlight": "^1.2.3",
    "axios": "^1.20.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.15",
    "element-plus": "^2.14.5",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "monaco-editor": "^0.56.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.7",
    "sass-embedded": "^1.104.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
